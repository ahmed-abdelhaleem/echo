# Interaction review captures. PNG sequences and MP4s are large, fully
# reproducible artifacts (`make unity-capture-interactions`) and belong in CI,
# not in Git. Approved golden contact frames are committed separately under
# tools/capture/golden/ so the benchmark has a reviewed reference to diff against.
[Cc]aptures/

# Unity/Mono crash diagnostics are machine-specific and may be very large.
sysinfo.txt
crash.dmp
mono_crash.*.json

# Local IDE state generated beside the Unity project.
.vs/
.vscode/

# Mixamo permits use in games, but raw downloadable files are not redistributed
# from this repository. See the local asset README for the reproducible import.
Assets/Resources/Characters/YBot/*.fbx
Assets/Resources/Characters/YBot/*.fbx.meta
Assets/Resources/Characters/Noor/*.fbx
Assets/Resources/Characters/Noor/*.fbx.meta
