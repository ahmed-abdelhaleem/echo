# Local development environment for `services/core-go` and helpers.
# Copy to `.env` at the repo root (gitignored) before `make dev-core` / `make dev-ml-grpc`.
#
#   cp .env.example .env
#
# Requires `docker compose up -d` (Postgres, Redis, NATS, Kratos).

DATABASE_URL=postgres://echo:echo_dev@localhost:5432/echo?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Path to the repo's content/ tree. Use an absolute path if you start core-go
# from a directory other than services/core-go.
CONTENT_ROOT=../../content

KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434
# Must match KRATOS_HOOK_SECRET in docker-compose.yml (Kratos → core-go hooks).
KRATOS_HOOK_SECRET=echo_dev_hook_secret_change_me_in_prod

# ml-py gRPC (run `make dev-ml-grpc` in another terminal).
ML_GRPC_ADDR=127.0.0.1:50051

# AI 3D asset generation. TRELLIS runs as a separate local/internal process;
# CUDA and Apple Silicon backends are documented in services/trellis-py/README.md.
ECHO_ASSET_GEN_ENABLED=false
ECHO_ASSET_GEN_PRIMARY=trellis
ECHO_ASSET_GEN_FALLBACKS=
TRELLIS_BASE_URL=http://127.0.0.1:8090
TRELLIS_API_STYLE=echo
TRELLIS_TIMEOUT_SECONDS=900

# T-ML-051 background asset worker. The local backend writes deterministic
# object keys beneath .echo-assets; production uses the R2 settings below.
NATS_URL=nats://127.0.0.1:4222
ECHO_ASSET_MAX_BYTES=15000000
ECHO_ASSET_LEASE_SECONDS=3600
ECHO_ASSET_STORE_BACKEND=local
ECHO_ASSET_STORE_DIR=.echo-assets
GLTFPACK_BIN=gltfpack

# Set ECHO_ASSET_STORE_BACKEND=r2 in deployed worker replicas.
R2_ASSET_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

ECHO_ENV=dev
CORE_HTTP_ADDR=:8081

# Flutter web on random localhost ports (default on when ECHO_ENV=dev)
CORE_CORS_ALLOW_LOCALHOST=true
# Keep Kratos API on same origin via core-go (/auth/kratos/*). Defaults to
# true in dev and false outside dev if unset.
CORE_ENABLE_KRATOS_PROXY=true

# Google OIDC (optional — https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI in Google Console:
#   http://localhost:4433/self-service/methods/oidc/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
